{
  "name": "SWARX",
  "start_url": "/",
  "tac": {
    "application": {
      "id": "ma.del.agent-observatory",
      "version": "0.1.0",
      "window": {
        "width": 1240,
        "height": 850,
        "controls": [
          "title"
        ]
      },
      "menus": {
        "file": [
          {
            "id": "monitor",
            "label": "Open Monitor",
            "route": "/"
          }
        ],
        "view": [
          {
            "id": "running",
            "label": "What's Running",
            "route": "/",
            "shortcut": {
              "key": "1",
              "modifiers": [
                "command"
              ]
            }
          }
        ],
        "help": [
          {
            "id": "local-help",
            "label": "SWARX Help",
            "route": "/help"
          }
        ]
      },
      "rust": {
        "dependencies": {
          "libc": "=0.2.189",
          "serde": {
            "version": "=1.0.229",
            "features": [
              "derive"
            ]
          },
          "serde_json": "=1.0.151",
          "regex": "=1.13.1"
        },
        "platformDependencies": {
          "windows": {
            "windows-sys": {
              "version": "=0.61.2",
              "features": [
                "Win32_Foundation",
                "Win32_Security",
                "Win32_Security_Authorization",
                "Win32_Security_Cryptography",
                "Win32_Storage_FileSystem",
                "Win32_System_Diagnostics_ToolHelp",
                "Win32_System_IO",
                "Win32_System_Pipes",
                "Win32_System_ProcessStatus",
                "Win32_System_Threading",
                "Win32_System_Time"
              ]
            }
          }
        },
        "executables": {
          "observatory-event": "/shared/native/EventEmitterMain.rs"
        }
      }
    },
    "styles": [
      "/shared/styles/app.css"
    ],
    "styleSources": {
      "/shared/styles/app.css": {
        "kind": "foundation"
      },
      "/shared/assets/duvay/duvay.min.css": {
        "kind": "vendor",
        "package": "DuVay",
        "version": "26.35.01",
        "license": "MIT",
        "sha256": "dd0b9a6841313bc3b4bf30da476dc1aa88821a58220d662b679f83873b92c768"
      }
    },
    "scripts": [
      "/shared/assets/duvay/duvay-wc.min.js",
      "/shared/assets/duvay/duvay.min.js",
      "/shared/assets/chartjs/chart.umd.min.js"
    ],
    "scriptSources": {
      "/shared/assets/duvay/duvay-wc.min.js": {
        "package": "DuVay",
        "version": "26.35.01",
        "license": "MIT",
        "sha256": "bd252fed5bb8a90f4c4f9eb1ac8d948e8b5c9dcf88e35ccfe30915ba9d2960de"
      },
      "/shared/assets/duvay/duvay.min.js": {
        "package": "DuVay",
        "version": "26.35.01",
        "license": "MIT",
        "sha256": "50ca0fd49f2232e3520f9e3d1fe8efa1fec1948a69e1076d43ed649a09b80d5b"
      },
      "/shared/assets/chartjs/chart.umd.min.js": {
        "package": "Chart.js",
        "version": "4.5.1",
        "license": "MIT",
        "sha256": "48444a82d4edcb5bec0f1965faacdde18d9c17db3063d042abada2f705c9f54a"
      }
    },
    "budgets": {
      "script": 1800,
      "style": 1000
    },
    "names": {
      "words": [
        "cpu",
        "pid",
        "ppid",
        "rss",
        "inode",
        "codex",
        "claude",
        "qwen",
        "pi",
        "goose",
        "opencode",
        "gemini"
      ]
    },
    "metadata": {
      "defaults": {
        "title": "SWARX"
      },
      "routes": {
        "/help": {
          "title": "SWARX Help"
        }
      }
    }
  }
}
