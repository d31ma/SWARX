{
  "name": "Agent Observatory",
  "start_url": "/",
  "tac": {
    "application": {
      "id": "ma.del.agent-observatory",
      "version": "0.1.0",
      "window": {
        "width": 1240,
        "height": 850
      },
      "menus": {
        "file": [
          {
            "id": "monitor",
            "label": "Open Monitor",
            "route": "/"
          }
        ],
        "view": [
          {
            "id": "running",
            "label": "What's Running",
            "route": "/",
            "shortcut": {
              "key": "1",
              "modifiers": [
                "command"
              ]
            }
          },
          {
            "id": "processes",
            "label": "Processes",
            "route": "/processes",
            "shortcut": {
              "key": "2",
              "modifiers": [
                "command"
              ]
            }
          },
          {
            "id": "runtimes",
            "label": "Runtimes",
            "route": "/runtimes",
            "shortcut": {
              "key": "3",
              "modifiers": [
                "command"
              ]
            }
          },
          {
            "id": "history",
            "label": "Resource History",
            "route": "/history",
            "shortcut": {
              "key": "4",
              "modifiers": [
                "command"
              ]
            }
          },
          {
            "id": "activity",
            "label": "Activity",
            "route": "/activity",
            "shortcut": {
              "key": "5",
              "modifiers": [
                "command"
              ]
            }
          }
        ],
        "help": [
          {
            "id": "local-help",
            "label": "Swarx Help",
            "route": "/help"
          }
        ]
      }
    },
    "styles": [
      "/shared/styles/app.css"
    ],
    "styleSources": {
      "/shared/styles/app.css": {
        "kind": "foundation"
      },
      "/shared/assets/duvay/duvay.min.css": {
        "kind": "vendor",
        "package": "DuVay",
        "version": "26.35.01",
        "license": "MIT",
        "sha256": "dd0b9a6841313bc3b4bf30da476dc1aa88821a58220d662b679f83873b92c768"
      }
    },
    "scripts": [
      "/shared/assets/duvay/duvay-wc.min.js",
      "/shared/assets/duvay/duvay.min.js",
      "/shared/assets/chartjs/chart.umd.min.js"
    ],
    "scriptSources": {
      "/shared/assets/duvay/duvay-wc.min.js": {
        "package": "DuVay",
        "version": "26.35.01",
        "license": "MIT",
        "sha256": "bd252fed5bb8a90f4c4f9eb1ac8d948e8b5c9dcf88e35ccfe30915ba9d2960de"
      },
      "/shared/assets/duvay/duvay.min.js": {
        "package": "DuVay",
        "version": "26.35.01",
        "license": "MIT",
        "sha256": "50ca0fd49f2232e3520f9e3d1fe8efa1fec1948a69e1076d43ed649a09b80d5b"
      },
      "/shared/assets/chartjs/chart.umd.min.js": {
        "package": "Chart.js",
        "version": "4.5.1",
        "license": "MIT",
        "sha256": "48444a82d4edcb5bec0f1965faacdde18d9c17db3063d042abada2f705c9f54a"
      }
    },
    "budgets": {
      "script": 1800,
      "style": 1000
    },
    "names": {
      "words": [
        "cpu",
        "pid",
        "ppid",
        "rss",
        "inode",
        "codex",
        "claude",
        "qwen",
        "pi",
        "goose",
        "opencode",
        "gemini"
      ]
    },
    "metadata": {
      "defaults": {
        "title": "Swarx Agent Observatory"
      },
      "routes": {
        "/help": {
          "title": "Swarx Help"
        }
      }
    }
  }
}
